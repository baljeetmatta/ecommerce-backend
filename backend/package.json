{
  "name": "ecommerce-admin-backend",
  "version": "1.0.0",
  "description": "Node.js and MongoDB API for an e-commerce admin panel.",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed": "node src/seed.js",
    "migrate:sellers": "node src/migrations/sellerTerminology.js",
    "migrate:seller-gst-optional": "node src/migrations/makeSellerGstOptional.js",
    "migrate:partner-payment-indexes": "node src/migrations/fixPartnerPaymentIndexes.js",
    "audit:product-media": "node src/migrations/migrateProductDataUrls.js",
    "migrate:product-media": "node src/migrations/migrateProductDataUrls.js --apply",
    "audit:legacy-media": "node src/migrations/migrateLegacyMedia.js",
    "migrate:legacy-media": "node src/migrations/migrateLegacyMedia.js --apply",
    "clear:commerce-data": "node src/migrations/clearCommerceData.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
