# Device-reachable API. Android emulator: http://10.0.2.2:5001/api
# Physical device: http://YOUR_COMPUTER_LAN_IP:5001/api
EXPO_PUBLIC_API_URL=https://ebackend.hrsbasket.com/api
# Base for frontend-owned /images assets and external storefront links.
EXPO_PUBLIC_STOREFRONT_URL=https://hrsbasket.com
# Public Cloudflare Turnstile widget site key used on customer signup.
EXPO_PUBLIC_TURNSTILE_SITE_KEY=replace-with-your-turnstile-site-key
